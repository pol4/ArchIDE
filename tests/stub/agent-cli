#!/usr/bin/env python3
"""Stub external coding agent (Ф8.2) — deterministic, no real code generation.

Reads the task prompt the adapter passes in the environment, writes a small
project into the working directory it was given, and records what it saw so a
test can assert the handoff really reached the agent.
"""
from __future__ import annotations

import json
import os
import pathlib
import sys

work = pathlib.Path(os.environ.get("ARCHIDE_CLI_WORK", "."))
prompt_path = pathlib.Path(os.environ.get("ARCHIDE_CLI_PROMPT", ""))
state = pathlib.Path(os.environ.get("STUB_STATE", "/tmp/archide-stub"))
state.mkdir(parents=True, exist_ok=True)

prompt = ""
if prompt_path.is_file():
    prompt = prompt_path.read_text(encoding="utf-8", errors="ignore")
with (state / "agent-cli.jsonl").open("a", encoding="utf-8") as fh:
    fh.write(json.dumps({"work": str(work), "prompt": prompt[:2000]}, ensure_ascii=False) + "\n")

(work / "src").mkdir(parents=True, exist_ok=True)
(work / "src" / "app.py").write_text("print('generated by the external CLI agent')\n", encoding="utf-8")
(work / "README.md").write_text("# generated by the external agent\n", encoding="utf-8")
print("stub agent: wrote 2 files into", work, flush=True)

if os.environ.get("STUB_FAIL") == "1":
    print("stub agent: failing on purpose", file=sys.stderr, flush=True)
    raise SystemExit(1)
raise SystemExit(0)
